{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "parquet_load",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "parquet_br",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "watermark_in",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     last_load as string",
				"}",
				"source(output(",
				"          transaction_date as string,",
				"          shipment_id as string,",
				"          carrier as string,",
				"          origin_city as string,",
				"          dest_city as string,",
				"          planned_eta as string,",
				"          actual_eta as string,",
				"          delay_hours as decimal(10,0),",
				"          weight_kg as decimal(10,0),",
				"          commodity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     wildcardPaths:['shipments_*.parquet']) ~> source1",
				"source1 filter(toDate(left(transaction_date, 10)) > toDate(left($last_load, 10))) ~> filter1",
				"filter1 aggregate(actual_eta = max(actual_eta)) ~> aggregate1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     preCommands: [],",
				"     postCommands: []) ~> sink1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['watermark.json'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     mapColumn(",
				"          last_load = actual_eta",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}
{
	"name": "load_weather",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"City": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "@dataset().FileName",
				"folderPath": {
					"value": "@concat('weather/', dataset().City)",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			}
		},
		"schema": {}
	}
}